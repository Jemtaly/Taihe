function InvokeBlockingFunctionFromCurrentThread(
    func: () => String,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeNonBlockingFunctionFromCurrentThread(
    func: @non_blocking () => Future<String>,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeBlockingFunctionFromAnotherThread(
    func: () => String,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeNonBlockingFunctionFromAnotherThread(
    func: @non_blocking () => Future<String>,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

interface BlockingInvokable {
    invoke(): String;
}

interface NonBlockingInvokable {
    @non_blocking invoke(): Future<String>;
}

function InvokeBlockingMethodFromCurrentThread(
    obj: BlockingInvokable,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeNonBlockingMethodFromCurrentThread(
    obj: NonBlockingInvokable,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeBlockingMethodFromAnotherThread(
    obj: BlockingInvokable,
    cb: @non_blocking @noexcept (a: String) => Future<void>);

function InvokeNonBlockingMethodFromAnotherThread(
    obj: NonBlockingInvokable,
    cb: @non_blocking @noexcept (a: String) => Future<void>);
